---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, getLangFromUrl, useTranslations } from '../i18n/utils';


/** Get the translation function for the current language. */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="About | Oiva Salomaa" description="About Oiva Salomaa">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title={t('about.title')}
				tagline={t('about.tagline')}
			>
				<img
					width="1553"
					height="873"
					src={withBase("/assets/at-work.jpg")}
					alt="Mr. Bean"
				/>
			</Hero>

			<section>
				<h2 class="section-title">{t('about.background.title')}</h2>
				<div class="content">
					<p>
						{t('about.background.part1')}
					</p>
					<p>
						{t('about.background.part2')}
					</p>
					<p>
						{t('about.background.part3')}
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">{t('about.education.title')}</h2>
				<div class="content">
					<p>{t('about.education.text')}</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">{t('about.languages.title')}</h2>
				<div class="content">
					<p>{t('about.languages.text')}</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">{t('about.intrests.title')}</h2>
				<div class="content">
					<p>{t('about.intrests.text')}</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
