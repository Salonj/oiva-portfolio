---
interface Props {
	subheading: string;
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title, subheading } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h3 class="subheading">{subheading}</h3>
		<h2 class="title">{title}</h2>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline,
	.subheading {
		max-width: 37ch;
		margin-inline: auto;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline,
		.start .subheading {
			margin-inline: unset;
		}
	}
</style>
